# HartaKu AI — Environment Variables
#
# 1. NVIDIA NIM API Key — Transaction parsing (nemotron-mini-4b-instruct)
#    Get: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=YOUR_NVIDIA_NIM_API_KEY_HERE
#
# 2. Groq API Key — Speech-to-Text (whisper-large-v3-turbo)
#    Get: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE